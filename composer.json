{
    "name": "blax-software/laravel-mail",
    "type": "library",
    "description": "Tracked outbound + IMAP-synced inbound mail for Laravel. Per-mailbox SMTP/IMAP credentials, threaded messages, open/click tracking, CQRS read side, scheduler-friendly poller.",
    "keywords": [
        "mail",
        "email",
        "imap",
        "smtp",
        "tracking",
        "inbox",
        "laravel",
        "blax",
        "cqrs"
    ],
    "homepage": "http://www.blax.at",
    "license": "MIT",
    "authors": [
        {
            "name": "Fabian Wagner",
            "email": "fabian@blax.at",
            "homepage": "https://www.blax.at",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Blax\\Mail\\": "src",
            "Blax\\Mail\\Database\\Factories\\": "database/factories"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.2",
        "directorytree/imapengine": "^1.0",
        "illuminate/bus": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/container": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/mail": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/framework": "*",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Blax\\Mail\\MailServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Blax\\Mail\\Tests\\": "tests",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --ansi"
        ],
        "test": [
            "@clear",
            "@php vendor/bin/phpunit"
        ]
    }
}
